__pycache__/
*.pyc
venv/
env/
.venv/
.env
static/uploads/*
!static/uploads/.gitkeep
.DS_Store
*.xml
!utils/data/*.xml
.idea/
.vscode/

# Trained model contains real students' face data (biometric) — keep it
# out of git, especially if the repo is public. MongoDB is the copy that
# actually powers the live app; this local file regenerates every time
# you click "Train Model".
models/*.pkl
!models/.gitkeep
